{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChatGPT",
  "version": "1.0.12",
  "identifier": "com.chatgpt.desktop",
  "build": {
    "frontendDist": "../frontend",
    "devUrl": "https://chatgpt.com"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "dangerousDisableAssetCspModification": true,
      "csp": null,
      "capabilities": [
        {
          "identifier": "desktop-notifications",
          "windows": [
            "main"
          ],
          "remote": {
            "urls": [
              "https://chatgpt.com/*"
            ]
          },
          "permissions": [
            "allow-notify-answer",
            "allow-open-external"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": null,
        "sidebarImage": null
      }
    }
  }
}
